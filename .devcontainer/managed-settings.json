{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(//mnt/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.dev)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.secret)",
      "Read(**/.env.secrets)",
      "Bash(gh pr merge *)",
      "Bash(gh auth *)",
      "Bash(gh secret *)",
      "Bash(gh release *)",
      "Bash(gh repo delete *)",
      "Bash(npm publish *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(git reset --hard *)",
      "Bash(git rebase *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git filter-branch *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(npm test *)",
      "Bash(pytest *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl * http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl * http://127.0.0.1:*)",
      "Bash(curl http://[::1]:*)",
      "Bash(curl * http://[::1]:*)",
      "Bash(curl http://0.0.0.0:*)",
      "Bash(curl * http://0.0.0.0:*)",
      "Bash(wget http://localhost:*)",
      "Bash(wget * http://localhost:*)",
      "Bash(wget http://127.0.0.1:*)",
      "Bash(wget * http://127.0.0.1:*)",
      "Bash(wget http://[::1]:*)",
      "Bash(wget * http://[::1]:*)",
      "Bash(wget http://0.0.0.0:*)",
      "Bash(wget * http://0.0.0.0:*)",
      "Bash(nc http://localhost:*)",
      "Bash(nc * http://localhost:*)",
      "Bash(nc http://127.0.0.1:*)",
      "Bash(nc * http://127.0.0.1:*)",
      "Bash(nc http://[::1]:*)",
      "Bash(nc * http://[::1]:*)",
      "Bash(nc http://0.0.0.0:*)",
      "Bash(nc * http://0.0.0.0:*)",
      "Bash(curl https://localhost:*)",
      "Bash(curl * https://localhost:*)",
      "Bash(curl https://127.0.0.1:*)",
      "Bash(curl * https://127.0.0.1:*)",
      "Bash(nc -z localhost *)",
      "Bash(nc -z 127.0.0.1 *)"
    ]
  },
  "allowManagedPermissionRulesOnly": true,
  "disableAllHooks": true,
  "allowedMcpServers": [],
  "disableCommandPluginSources": true,
  "disableSideloadFlags": true,
  "disableAutoMode": "disable",
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
